# Copie para .env e troque a senha antes de subir o banco.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskly
DB_USER=taskly
DB_PASSWORD=troque-esta-senha

# Segredo usado para assinar os tokens JWT (mínimo de 32 caracteres).
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio

# Opcional: cria o primeiro ADMIN na subida da API.
TASKLY_ADMIN_EMAIL=
TASKLY_ADMIN_SENHA=
